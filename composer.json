{
    "name": "tbaddade/sprog",
    "description": "REDAXO-AddOn für mehrsprachige Inhalte: Wildcards, Übersetzungen, Glossar, TM, MT.",
    "type": "redaxo-addon",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "symfony/serializer": "^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.65"
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
