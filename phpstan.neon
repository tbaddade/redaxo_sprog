parameters:
    # Level 8 ist der Zielwert; REDAXO-Core wird per scanDirectories für die
    # rex_*-Klassen aufgelöst. Bei Bedarf später durch staabm/redaxo-phpstan
    # ersetzen — für die aktuelle Tranche reichen die Core-Stubs aus.
    level: 8

    phpVersion: 80400

    paths:
        - lib

    excludePaths:
        - vendor/*

    # REDAXO-Core liegt in der üblichen Verzeichnisstruktur zwei Ebenen
    # über der Addon-Wurzel. Bei abweichendem Setup bitte hier anpassen.
    # structure-Addon wird ebenfalls gescannt, weil Sync.php und Copy/*
    # rex_article_cache / rex_article_content referenzieren.
    scanDirectories:
        - ../../core
        - ../structure

    # Compat-Layer-Bridges legen wir absichtlich locker aus, weil sie
    # dynamisch v1-Klassen aliasen — die kennt PHPStan nicht.
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # ai_platform ist eine WEICHE Abhängigkeit: der MT-Provider prüft zur
        # Laufzeit via class_exists() und meldet sich nur als konfiguriert, wenn
        # das AddOn installiert ist. Ohne ai_platform kann PHPStan die Klasse
        # FriendsOfRedaxo\AiPlatform\Service nicht auflösen — gewollt, kein Fehler.
        -
            identifier: class.notFound
            path: lib/Sprog/Mt/AiPlatformProvider.php
